# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nextcommerce?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/nextcommerce?schema=public"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# Auth
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
REFRESH_TOKEN_SECRET="your-super-secret-refresh-key-min-32-chars"

# Encryption (32 chars base64 for AES-256)
ENCRYPTION_KEY="32-char-base64-encryption-key-here"

# Mercado Pago (Payment Gateway)
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-..."
MERCADO_PAGO_PUBLIC_KEY="APP_USR-..."
MERCADO_PAGO_WEBHOOK_SECRET="whsec_..."

# Redis/Upstash (Cache, Rate Limit, Idempotency)
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# Email (optional - for transactional emails)
SENDGRID_API_KEY="SG...."
SENDGRID_FROM_EMAIL="noreply@seudominio.com"

# Storage (Supabase Storage buckets: product-images, nfe-xml, nfe-pdf, user-avatars)
# Already configured via Supabase URL/Keys above