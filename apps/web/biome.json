{
  "extends": ["../../biome.json"],
  "files": {
    "ignore": ["next-env.d.ts", ".next/**"]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "a11y": {
        "useAltText": "warn"
      }
    }
  }
}
