# ============================================
# NextCommerce Monorepo — .gitignore
# ============================================

# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Build Outputs ----
dist/
build/
.next/
out/
*.tsbuildinfo

# ---- Environment Files ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ---- IDE / Editor ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Testing ----
coverage/
.nyc_output/
*.lcov
.playwright-test-results/
playwright-report/
test-results/

# ---- Turbo / Cache ----
.turbo/
.cache/
.eslintcache
.stylelintcache
.biomecache/

# ---- Prisma ----
prisma/migrations/.migration_lock.toml
# NOTE: prisma/migrations/ folder IS committed (versioned migrations)
# Only the lock file above is ignored

# ---- Generated / Compiled ----
*.generated.ts
*.d.ts
!*.d.ts.map

# ---- OS / Misc ----
*.pem
.vercel
.netlify
.render

# ---- Package Manager ----
pnpm-lock.yaml  # COMMIT THIS FILE (ensures reproducible installs)
# If you use pnpm, DO NOT ignore pnpm-lock.yaml

# ---- Temporary Files ----
tmp/
temp/
*.tmp
*.temp

# ---- Storybook ----
storybook-static/

# ---- Database ----
*.sqlite
*.db
*.sqlite3

# ---- Docker ----
.docker/

# ---- CI/CD ----
.github/workflows/dependabot.yml  # Optional: ignore if auto-generated

# ---- Workspace Specific Ignores ----
# apps/web
apps/web/.next/
apps/web/out/
apps/web/build/
apps/web/coverage/
apps/web/.vercel/
apps/web/node_modules/

# apps/api
apps/api/dist/
apps/api/build/
apps/api/coverage/
apps/api/prisma/migrations/.migration_lock.toml
apps/api/node_modules/

# packages/shared
packages/shared/dist/
packages/shared/build/
packages/shared/coverage/
packages/shared/node_modules/

# ---- Keep these (do NOT ignore) ----
# .github/workflows/           # CI pipelines
# prisma/migrations/           # Versioned migrations
# pnpm-lock.yaml               # Lockfile
# .env.example                 # Template
# biome.json                   # Config
# tsconfig.json                # Config
# tailwind.config.ts           # Config
# next.config.ts               # Config
# vitest.config.ts             # Config
# playwright.config.ts         # Config